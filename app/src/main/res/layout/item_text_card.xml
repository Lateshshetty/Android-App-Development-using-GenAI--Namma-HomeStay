<?xml version="1.0" encoding="utf-8"?>
<!-- Used by TextCardAdapter for all RecyclerView listings.
     IDs 'text' and 'image' must NOT be renamed. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:layout_marginStart="@dimen/spacing_xs"
    android:layout_marginEnd="@dimen/spacing_xs"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/colorCardBorder"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Image (hidden when no photo) -->
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@color/shimmer_base"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Warm divider below image when image is visible -->
        <View
            android:id="@+id/image_divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/colorDivider"
            android:visibility="gone" />

        <!-- Card text content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:minHeight="@dimen/touch_target"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
