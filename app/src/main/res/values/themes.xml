<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════════════════════════════════════
         Main App Theme
         ══════════════════════════════════════════ -->
    <style name="Theme.NammaHomestay" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorError">@color/colorError</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorNavBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.NammaHomestay.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash_gradient</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/colorPrimaryLight</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ══════════════════════════════════════════
         Buttons
         ══════════════════════════════════════════ -->
    <style name="Widget.NammaHomestay.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <style name="Widget.NammaHomestay.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!-- ══════════════════════════════════════════
         Cards
         ══════════════════════════════════════════ -->
    <style name="Widget.NammaHomestay.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/colorCardBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
    </style>

    <style name="Widget.NammaHomestay.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/colorNavBackground</item>
        <item name="itemIconTint">@color/colorNavActive</item>
        <item name="itemTextColor">@color/colorNavInactive</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.NammaHomestay.BottomNav.ActiveIndicator</item>
    </style>

    <style name="Widget.NammaHomestay.BottomNav.ActiveIndicator">
        <item name="android:color">@color/colorPrimaryLight</item>
    </style>

    <!-- ══════════════════════════════════════════
         OTP Boxes
         ══════════════════════════════════════════ -->
    <style name="OtpBox">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginEnd">@dimen/spacing_sm</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <!-- ══════════════════════════════════════════
         Text Appearances
         ══════════════════════════════════════════ -->
    <style name="TextAppearance.NammaHomestay.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.NammaHomestay.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
